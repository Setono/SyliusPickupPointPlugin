{% set form = hookable_metadata.context.form %}

{% if form.pickupPoint is defined %}
    {#
        The chooser is hidden until the shop JS (public/js/setono-pickup-point.js) decides it is needed:
        on render it only knows which methods are pickup-capable (the data-pickup-point-provider stamp on
        the method radios); the actual points are fetched asynchronously, so a slow/down provider never
        blocks this page. The user-facing strings live here (Twig) and reach the JS via data attributes.
    #}
    <div class="setono-sylius-pickup-point-field mb-3"
         data-pickup-point-field
         data-loading-text="{{ 'setono_sylius_pickup_point.ui.loading_pickup_points'|trans }}"
         data-empty-text="{{ 'setono_sylius_pickup_point.ui.no_pickup_points'|trans }}"
         data-error-text="{{ 'setono_sylius_pickup_point.ui.error_loading_pickup_points'|trans }}"
         hidden
    >
        <label class="form-label d-block">{{ 'setono_sylius_pickup_point.form.shipment.pickup_point'|trans }}</label>

        <div class="setono-sylius-pickup-point-field-choices" data-pickup-point-choices></div>

        {{ form_widget(form.pickupPoint, {'attr': {
            'data-pickup-point-input': '',
            'class': 'setono-sylius-pickup-point-field-input',
        }}) }}
        {{ form_errors(form.pickupPoint) }}
    </div>
{% endif %}
